# Dependencies
/node_modules/
/.pnp/
.pnp.*

# Build / test output (add your framework's dirs as needed)
/dist/
/build/
/coverage/
/out/

# Local env files — never commit real secrets
.env
.env*.local

# Python bytecode. `backend/` has its own ignore for this; `scripts/` needs one
# too because `backend/tests/test_seed_demo_app_data.py` imports the seeder from
# there, and importing it writes `scripts/__pycache__/`.
__pycache__/

# Editor / OS
.DS_Store
*.pem
*.tsbuildinfo

# Logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sidecar local data dir (simplified-design-specification.md §23). The default
# is now the OS's per-user location, outside any checkout
# (`auto_scoring.api.sidecar.default_app_data_dir`, docs/windows-distribution.md
# §3), but `--app-data-dir ./app-data` is still a normal thing to type while
# developing, from any of the three directories tests and tools run in.
/app-data/
/backend/app-data/
/app/app-data/

# PyInstaller output for the bundled sidecar (`pnpm run package:sidecar`).
# The distributable artifact is built by CI, never committed.
/backend/build/
/backend/dist/

# Inno Setup output (`pnpm run package:installer`). The installer is a CI
# artifact, never committed.
/installer/output/

# Scratch state left by a Codex-based code-review run against this worktree
# (its CODEX_HOME and log, and any protocol-schema dump it generates while
# investigating a finding) -- tooling output, not project content.
/.review-codex-home/
/codex-review-*.log
/.tmp-review-protocol-schema/
