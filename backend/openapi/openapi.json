{
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "overrides": {
            "items": {
              "$ref": "#/components/schemas/QuestionTextOverride"
            },
            "title": "Overrides",
            "type": "array"
          }
        },
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "ConfirmRequest": {
        "properties": {
          "edges": {
            "items": {
              "$ref": "#/components/schemas/DependencyEdgeModel"
            },
            "title": "Edges",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "edges"
        ],
        "title": "ConfirmRequest",
        "type": "object"
      },
      "DependencyEdgeModel": {
        "properties": {
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "from_question_id": {
            "title": "From Question Id",
            "type": "string"
          },
          "provides": {
            "items": {
              "$ref": "#/components/schemas/DependencyProvision"
            },
            "title": "Provides",
            "type": "array"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "to_question_id": {
            "title": "To Question Id",
            "type": "string"
          }
        },
        "required": [
          "from_question_id",
          "to_question_id",
          "provides",
          "rationale"
        ],
        "title": "DependencyEdgeModel",
        "type": "object"
      },
      "DependencyGraphResponse": {
        "properties": {
          "confirmed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/DependencyEdgeModel"
            },
            "title": "Edges",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "layers": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Layers",
            "type": "array"
          },
          "question_ids": {
            "items": {
              "type": "string"
            },
            "title": "Question Ids",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "test_id": {
            "title": "Test Id",
            "type": "string"
          },
          "unresolved": {
            "items": {
              "$ref": "#/components/schemas/UnresolvedQuestionModel"
            },
            "title": "Unresolved",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "test_id",
          "version",
          "status",
          "question_ids",
          "edges",
          "unresolved",
          "layers",
          "created_at"
        ],
        "title": "DependencyGraphResponse",
        "type": "object"
      },
      "DependencyProvision": {
        "description": "What a prerequisite question hands to its dependent (\u00a79.2 result shape).",
        "enum": [
          "recognized_text",
          "score",
          "criterion_result"
        ],
        "title": "DependencyProvision",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QuestionTextOverride": {
        "description": "Extracted PDF text for one question, supplied by the caller.\n\nThe MVP question record (Issue #11) does not yet store \u554f\u984c\u6587 text\nextracted from the model-answer/manual PDFs, so the analyze request\ncarries it explicitly -- once PDF text extraction exists this becomes the\ndefault and overrides stay optional.",
        "properties": {
          "prompt_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Text"
          },
          "question_id": {
            "title": "Question Id",
            "type": "string"
          },
          "rubric_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rubric Text"
          }
        },
        "required": [
          "question_id"
        ],
        "title": "QuestionTextOverride",
        "type": "object"
      },
      "ScoreRequest": {
        "properties": {
          "key": {
            "title": "Key",
            "type": "string"
          },
          "maximum": {
            "title": "Maximum",
            "type": "integer"
          },
          "raw": {
            "title": "Raw",
            "type": "integer"
          }
        },
        "required": [
          "key",
          "raw",
          "maximum"
        ],
        "title": "ScoreRequest",
        "type": "object"
      },
      "ScoreResponse": {
        "properties": {
          "awarded": {
            "title": "Awarded",
            "type": "integer"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "maximum": {
            "title": "Maximum",
            "type": "integer"
          },
          "ratio": {
            "title": "Ratio",
            "type": "number"
          }
        },
        "required": [
          "key",
          "awarded",
          "maximum",
          "ratio"
        ],
        "title": "ScoreResponse",
        "type": "object"
      },
      "UnresolvedQuestionModel": {
        "properties": {
          "question_id": {
            "title": "Question Id",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "question_id",
          "reason"
        ],
        "title": "UnresolvedQuestionModel",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Per-session token minted when the sidecar starts.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Auto-Scoring Sidecar",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
