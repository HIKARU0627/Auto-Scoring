    "/jobs/{job_id}/cancel": {
      "post": {
        "description": "For a QUEUED/BLOCKED/FAILED job, `queue_service.cancel_job`\nitself already wrote CANCELLED before returning -- 200 with that\nresult is accurate. For a RUNNING job, it only *requests*\ncancellation and hands back the pre-cancellation snapshot (still\n``state: RUNNING``): the actual write is owned by whichever worker\ntask is processing it, and happens moments later, asynchronously\n(`JobQueueService.cancel_job`'s own docstring). Answering 200 with\nthat stale snapshot would read as \"nothing happened\"; 202 says the\nrequest was accepted but not yet applied (review round 6, P2).",
        "operationId": "cancel_job_jobs__job_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            },
            "description": "Cancellation requested for a RUNNING job; not yet applied -- the body is the pre-cancellation snapshot (still `\"state\": \"running\"`). The actual CANCELLED write happens moments later, asynchronously."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Cancel Job",
        "tags": [
          "jobs"
        ]
      }
    },
