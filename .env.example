# Copy to .env.local and fill in locally. Never commit real secrets or full
# connection strings. Example values only live here; real values go in your
# local .env.local or your hosting provider's environment settings.

# Public origin of the deployed app, if your app needs a same-origin check.
# Bare origin only: no path, query, or trailing slash.
APP_ORIGIN=https://example.com

# Add project-specific variables below (database URLs, API keys, ...).

# --- OCR: Google Document AI (Issue #114) -----------------------------------
# Only the Python sidecar holds OCR credentials. Put real values in
# backend/.env.local (git-ignored) or the OS keychain; never commit them.
#
# Adopted service: Google Document AI (business-rules-and-evaluation-data.md
# section 3 (A), Issue #81; adapter in
# backend/src/auto_scoring/adapters/ocr/document_ai_provider.py).
#
# ONE variable, holding the full processor resource name exactly as Cloud
# Console shows it. Project, location and processor id have to agree -- a
# processor only exists in the location it was created in -- so three separate
# variables would only create a way to make them disagree.
#
# Authenticate with Application Default Credentials, NOT an API key: the
# project owner's organisation policy refuses API keys outright ("組織のセキュ
# リティ ポリシーで API キーが許可されていません"). Run `gcloud auth
# application-default login` once; the SDKs then find the credentials on their
# own, so there is no key to put in this file and none to leak.
#
# On a server, prefer an attached service account (Cloud Run, Compute Engine,
# GKE) or Workload Identity Federation: ADC finds those on its own, so there is
# no long-lived key to issue, store or rotate -- and some organisations forbid
# creating one at all. GOOGLE_APPLICATION_CREDENTIALS points at a
# service-account JSON *or* a Federation config; reach for the JSON key only
# when neither of the keyless routes is available.
#
# Leaving this unset is a supported configuration, not a broken one: the app
# starts, grades, and still releases dependent questions without OCR
# (simplified-design-specification.md section 24). `GET /ocr/availability`
# then reports why. What is lost is the cross-check against the grading AI's
# own reading, and text-anchored annotation positions (section 8.1.5).
AUTO_SCORING_DOCUMENT_AI_PROCESSOR=projects/your-gcp-project/locations/us/processors/your-processor-id

# The quota project ADC bills the Document AI call to comes from ADC unless
# AUTO_SCORING_VERTEX_PROJECT (in the AI grading block below) overrides it --
# the same one variable, deliberately, so a host that configured grading has
# already configured this.

# PoC 1's other comparison candidates are recorded in
# docs/poc-1-japanese-handwriting-ocr.md. None was adopted, and none has an
# adapter, so none has configuration here.

# --- AI grading PoC 2 (docs/poc-2-ai-grading.md) -----------------------------
# Only the Python sidecar holds AI grading credentials. Put real values in
# backend/.env.local (git-ignored) or the OS keychain; never commit them.
# The adopted configuration is an ordered fallback chain -- Gemini API (Vertex
# AI) > Codex App Server > OpenRouter > OpenAI API (business-rules-and-
# evaluation-data.md section 3 (B), Issue #81) -- and
# AUTO_SCORING_AI_GRADING_TRANSPORT below takes that whole order as a
# comma-separated list. Links whose credentials are not set here are simply
# left out of the chain, so a machine that only has one of them still works.

# Google Gemini (structured JSON output), reached through Vertex AI. Same
# reason as the OCR block above: the organisation policy blocks API keys, so
# this is ADC, not AUTO_SCORING_GEMINI_API_KEY -- that variable is
# deliberately gone. `gcloud auth application-default login` is the whole
# setup. The quota project comes from ADC unless overridden here, so no real
# GCP project id ever has to live in this repository.
AUTO_SCORING_VERTEX_PROJECT=your-gcp-project-id
# Optional. Defaults to "global", which has its own Vertex AI hostname; a
# regional value is prefixed onto that host instead.
AUTO_SCORING_VERTEX_LOCATION=us-central1
AUTO_SCORING_GEMINI_MODEL=gemini-2.5-flash

# OpenAI GPT (JSON schema / structured output mode).
AUTO_SCORING_OPENAI_API_KEY=your-openai-api-key
AUTO_SCORING_OPENAI_MODEL=gpt-4o-mini

# Sampling temperature applied uniformly across the Vertex AI / OpenRouter /
# OpenAI candidates for reproducibility (Issue #14 "再現条件"). Grading should stay
# close to deterministic. Does NOT apply to AUTO_SCORING_AI_GRADING_TRANSPORT=
# codex_app_server: Codex's app-server protocol has no temperature parameter,
# so this value is ignored for that transport (docs/poc-2-ai-grading.md
# section 7.1 "共通").
AUTO_SCORING_AI_GRADING_TEMPERATURE=0.0

# Short, stable tag for the prompt template version (never the prompt text
# itself) -- recorded verbatim into ProviderDescriptor.prompt_version
# (docs/poc-2-ai-grading.md section 3.3). Bump it whenever
# adapters/ai_grading/_prompt.py changes: results recorded under the old tag
# were produced by a different template and must not be pooled with the new
# ones. v2 = Issue #121 (over-long comments are truncated, not rejected).
# v3 = Issue #136 (the model reports what the attached image shows, in
# `answerImage`, separately from the score it gave that image).
AUTO_SCORING_AI_GRADING_PROMPT_VERSION=v3

# --- AI grading transport selection (Issues #44/#35, docs/poc-2-ai-grading.md section 7) ---
# Comma-separated priority list, highest priority first, that
# auto_scoring.adapters.ai_grading.factory.create_ai_provider() turns into the
# fallback chain. Supported values: "gemini" (Vertex AI + ADC),
# "codex_app_server", "openrouter", "openai". A single value is still valid
# and yields that one adapter. A listed transport with no credentials on this
# machine is skipped rather than allowed to consume one step of the chain. If
# none of them are configured, the sidecar still starts -- answer intake,
# review and PDF export do not need a grading provider -- but AI grading is
# disabled: every grading job fails permanently, no grade is recorded, and the
# app shows a banner above every screen saying so (Issue #97,
# GET /grading/availability).
#
# 採点基準PDFからの配点抽出 (Issue #103) reads this same list -- there is no
# second variable for it. It uses the first listed transport that accepts
# images, so "codex_app_server" is skipped there (its protocol has no image
# input) and a list naming only that transport leaves extraction unavailable
# while grading still works. Extraction being unavailable is not fatal
# either: every value can be typed in by hand on the テスト設定画面
# (docs/criteria-extraction.md).
AUTO_SCORING_AI_GRADING_TRANSPORT=gemini,codex_app_server,openrouter,openai

# OpenRouter (https://openrouter.ai): single API key routed to many vendors'
# models. AUTO_SCORING_OPENROUTER_MODEL is OpenRouter's own routing id (e.g.
# "google/gemini-2.5-flash"), not a vendor SDK model name.
#
# This is also the one key an *installed* copy can be given without a shell:
# the settings screen's「APIキー」tab stores it in the OS credential store
# (Windows Credential Manager) and the sidecar reads it back at startup
# (Issue #96, docs/windows-distribution.md section 9). A stored key wins over
# this variable; the transport priority order above does not move either way.
# Leaving both unset is supported -- the app starts and only grading is off.
AUTO_SCORING_OPENROUTER_API_KEY=your-openrouter-api-key
AUTO_SCORING_OPENROUTER_MODEL=google/gemini-2.5-flash

# Codex CLI app-server (docs/poc-2-ai-grading.md section 7.1.2): no API key
# lives here. Auth reuses the operator's own `codex login` session on this
# host (ChatGPT plan or Codex's own API key setting) -- run `codex login`
# once, outside this repo, before selecting this transport. On a host where
# the executable below is not installed at all, this link is left out of the
# chain rather than kept as a step that is certain to fail.
AUTO_SCORING_CODEX_EXECUTABLE=codex
AUTO_SCORING_CODEX_MODEL=
