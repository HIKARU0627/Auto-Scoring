# Copy to .env.local and fill in locally. Never commit real secrets or full
# connection strings. Example values only live here; real values go in your
# local .env.local or your hosting provider's environment settings.

# Public origin of the deployed app, if your app needs a same-origin check.
# Bare origin only: no path, query, or trailing slash.
APP_ORIGIN=https://example.com

# Add project-specific variables below (database URLs, API keys, ...).

# --- OCR PoC 1 (docs/poc-1-japanese-handwriting-ocr.md) ---------------------
# Only the Python sidecar holds OCR credentials. Put real values in
# backend/.env.local (git-ignored) or the OS keychain; never commit them.

# Primary candidate: Google Cloud Vision (DOCUMENT_TEXT_DETECTION). Path to the
# service-account JSON key. The account needs only the Cloud Vision API.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vision-sa.json
OCR_GCP_PROJECT_ID=your-gcp-project-id

# Second candidate: Azure AI Vision (Image Analysis 4.0 Read).
OCR_AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
OCR_AZURE_VISION_KEY=your-azure-vision-key

# Local fallback (PaddleOCR / Tesseract) needs no credentials.

# --- AI grading PoC 2 (docs/poc-2-ai-grading.md) -----------------------------
# Only the Python sidecar holds AI grading credentials. Put real values in
# backend/.env.local (git-ignored) or the OS keychain; never commit them.
# At least 2 of the 3 candidates below must be configured to run the PoC 2
# comparison (business-rules-and-evaluation-data.md section 3 (B)).

# Google Gemini (structured JSON output / responseSchema mode).
AUTO_SCORING_GEMINI_API_KEY=your-gemini-api-key
AUTO_SCORING_GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (tool-use / structured output mode).
AUTO_SCORING_ANTHROPIC_API_KEY=your-anthropic-api-key
AUTO_SCORING_ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI GPT (JSON schema / structured output mode).
AUTO_SCORING_OPENAI_API_KEY=your-openai-api-key
AUTO_SCORING_OPENAI_MODEL=gpt-4o-mini

# Sampling temperature applied uniformly across candidates for reproducibility
# (Issue #14 "再現条件"). Grading should stay close to deterministic.
AUTO_SCORING_AI_GRADING_TEMPERATURE=0.0
