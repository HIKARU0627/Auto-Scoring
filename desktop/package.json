{
  "name": "@auto-scoring/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Auto-Scoring desktop shell (Electron + TypeScript + React + Vite). Replaces app/ after cut-over: docs/frontend-migration.md.",
  "author": "Auto-Scoring",
  "license": "MIT",
  "main": "out/main/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "start": "pnpm run build && electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "vite build -c vite.preload.config.mts",
    "build:renderer": "vite build",
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
    "package": "pnpm run build && electron-builder --win",
    "package:dir": "pnpm run build && electron-builder --win --dir",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.550.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
